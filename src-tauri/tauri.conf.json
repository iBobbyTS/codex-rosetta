{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex-Rosetta",
  "version": "0.1.0",
  "identifier": "dev.codex-rosetta.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:bootstrap",
    "frontendDist": "../webui/dist/bootstrap"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "bootstrap",
        "title": "Codex-Rosetta",
        "width": 520,
        "height": 420,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": ["app", "dmg", "msi", "nsis"],
    "resources": ["binaries/*"],
    "createUpdaterArtifacts": false
  }
}
