{
  "name": "codex-rosetta-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "npm run build:admin && npm run build:bootstrap",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:bootstrap": "vite build --config vite.bootstrap.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.10.13",
    "jsdom": "27.4.0",
    "svelte": "5.56.7",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  }
}
